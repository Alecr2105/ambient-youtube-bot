# =====================================================================
# ambient_youtube_bot — configuración
# Copiá este archivo a .env y ajustá los valores. .env nunca se versiona.
# Las rutas relativas se resuelven desde la raíz del repo.
# =====================================================================

# --- Modo ------------------------------------------------------------
# test: produce todo hasta READY y NO sube nada. production: sube y programa.
MODE=test
LOG_LEVEL=INFO

# --- Producción ------------------------------------------------------
VIDEOS_PER_DAY=1
# Duración en minutos. Si VIDEO_DURATION tiene valor, se usa exacto.
VIDEO_DURATION_MIN=180
VIDEO_DURATION_MAX=240
VIDEO_DURATION=
# Días de adelanto con videos READY/SCHEDULED en cola.
BUFFER_DAYS=2

# --- Horarios --------------------------------------------------------
# Zona del proceso (dónde corre la máquina).
TIMEZONE=America/Costa_Rica
# Zona del público objetivo.
PUBLISH_TIMEZONE=America/New_York
# Publicación: se elige un minuto aleatorio entre PUBLISH_HOUR y PUBLISH_HOUR + PUBLISH_WINDOW_MINUTES.
PUBLISH_HOUR=20
PUBLISH_WINDOW_MINUTES=120
# Hora local (TIMEZONE) en que arranca la producción diaria.
CREATE_HOUR=1
ACTIVE_WEEKDAYS=mon,tue,wed,thu,fri,sat,sun

# --- FFmpeg ----------------------------------------------------------
# Vacío = buscar en PATH y en la instalación de winget.
FFMPEG_PATH=
FFPROBE_PATH=

# --- Video -----------------------------------------------------------
RESOLUTION=1920x1080
FPS=30
# h264 | h265
VIDEO_CODEC=h264
VIDEO_BITRATE=5M
# Still pictures need far fewer bits than moving footage; used when nothing moves.
STATIC_VIDEO_BITRATE=800k
# off = the picture never moves (no zoom, no pan); full = slow zoom and pan.
VISUAL_MOTION=off
# footage = the owner's own footage; illustrated = illustrated scenes inspired by Costa Rica.
# Decides what the video description says about the picture.
VISUAL_STYLE=footage
# auto: usa GPU si el encoder funciona; true: exige GPU; false: siempre CPU.
USE_GPU=auto

# --- Audio -----------------------------------------------------------
AUDIO_SAMPLE_RATE=48000
# aac | opus
AUDIO_CODEC=aac
AUDIO_BITRATE=256k
TARGET_LUFS=-18
# Ambients offered for studying: the loudest 3 s may sit at most this far above the usual level.
STUDY_MAX_SHORT_TERM_JUMP_LU=5
TARGET_TRUE_PEAK=-1

# --- Costos (USD) ----------------------------------------------------
# 0 = no se ejecuta ninguna llamada con costo.
DAILY_BUDGET=0
MONTHLY_BUDGET=0

# --- Licencias -------------------------------------------------------
# Lista blanca. Valores posibles: CC0, CC-BY-3.0, CC-BY-4.0, OWN, PROCEDURAL, AI_COMMERCIAL
ALLOWED_LICENSES=CC0,PROCEDURAL,OWN

# --- Contenido -------------------------------------------------------
# Pesos relativos por subnicho (se normalizan).
SUBNICHE_WEIGHTS=relaxation:0.4,sleep:0.3,study:0.3
ENABLE_ES_LOCALIZATION=false
# Declaración de contenido alterado/sintético (status.containsSyntheticMedia).
DECLARE_SYNTHETIC_MEDIA=false

# --- YouTube ---------------------------------------------------------
YOUTUBE_CATEGORY_ID=10
# Deben estar FUERA del repo.
YOUTUBE_CLIENT_SECRETS_PATH=C:/Users/YOUR_USER/.ambient_bot/client_secret.json
YOUTUBE_TOKEN_PATH=C:/Users/YOUR_USER/.ambient_bot/youtube.token.json
YOUTUBE_PLAYLIST_ID=
# Cupos diarios por bucket (verificar en Google Cloud Console).
YOUTUBE_QUOTA_GENERAL_DAILY=10000
YOUTUBE_QUOTA_UPLOADS_DAILY=100
YOUTUBE_QUOTA_SEARCH_DAILY=100

# --- Proveedores de audio --------------------------------------------
# Orden de preferencia de proveedores externos.
AUDIO_PROVIDERS=own,freesound
FREESOUND_API_KEY=
FREESOUND_CLIENT_ID=
FREESOUND_TOKEN_PATH=C:/Users/YOUR_USER/.ambient_bot/freesound.token.json
PIXABAY_API_KEY=
# none | elevenlabs
AI_AUDIO_PROVIDER=none
AI_AUDIO_API_KEY=

# --- Metadata --------------------------------------------------------
# none = solo plantillas
LLM_PROVIDER=none
LLM_API_KEY=

# --- Reintentos ------------------------------------------------------
MAX_RETRIES=3
# Segundos base del backoff exponencial (base * 2^intento).
BACKOFF_BASE=60

# --- Rutas y almacenamiento ------------------------------------------
DATABASE_URL=sqlite:///data/bot.db
VISUALS_DIR=assets/visuals
AUDIO_OWN_DIR=assets/audio_own
OUTPUT_DIR=output
CACHE_DIR=cache
WORK_DIR=work
LOG_DIR=logs
# Días que se conserva video.mp4 tras publicar (metadata y reportes se conservan siempre).
RETENTION_DAYS=7
# No se inicia producción con menos espacio libre que esto.
MIN_FREE_DISK_GB=40
